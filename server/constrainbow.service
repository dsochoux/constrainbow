# systemd service for the Constrainbow web app (gunicorn)
# Installed to /etc/systemd/system/constrainbow.service by deploy.sh
#
# Useful commands on the server:
#   systemctl status constrainbow     # is it running? recent log lines
#   systemctl restart constrainbow    # restart (deploy.sh does this)
#   journalctl -u constrainbow -n 50  # service start/stop history

[Unit]
Description=Constrainbow web app (gunicorn)
# start after the network is up
After=network.target

[Service]
# run as an unprivileged user that can't log in, not as root
# (deploy.sh creates this user if it doesn't exist)
User=constrainbow
Group=constrainbow
# app.py uses paths relative to the repo root, so it must run from here
WorkingDirectory=/srv/constrainbow
# listen only on the server itself; the public reaches the app through nginx (HTTPS)
ExecStart=/srv/constrainbow/env/bin/gunicorn -w 4 project.app:app -b 127.0.0.1:5001
# if gunicorn ever exits or crashes, start it again 3 seconds later
Restart=always
RestartSec=3
# keep writing gunicorn's output to a log file
StandardOutput=append:/srv/constrainbow/gunicorn.log
StandardError=append:/srv/constrainbow/gunicorn.log

# sandboxing: even if the app had a bug, the process can only
# - write to the two places the app actually writes
# - never gain more privileges (no sudo, no setuid programs)
# - not see /root or /home at all, and get its own private /tmp
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/constrainbow/logs /srv/constrainbow/word_files/reported_missing_words.txt
ProtectHome=true
PrivateTmp=true

[Install]
# start at boot
WantedBy=multi-user.target
